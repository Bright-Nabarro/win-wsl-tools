// Portable Windows Terminal template (MSYS2 UCRT64 default + CLANG64 + PowerShell 7).
// Adjust the MSYS2 installation path (e.g. E:\\workspace\\msys2) if installed elsewhere.
{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": [
        { "command": { "action": "copy", "singleLine": false }, "id": "User.copy.644BA8F2" },
        { "command": "paste", "id": "User.paste" },
        { "command": "find", "id": "User.find" },
        { "command": { "action": "splitPane", "split": "auto", "splitMode": "duplicate" }, "id": "User.splitPane.A6751878" },
        { "command": { "action": "commandPalette" }, "id": "User.commandPalette.D470528E" },
        { "command": "toggleAlwaysOnTop", "id": "User.toggleAlwaysOnTop" },
        { "command": "nextTab", "id": "User.nextTab" },
        { "command": "prevTab", "id": "User.prevTab" },
        { "command": "markMode", "id": "User.markMode" }
    ],
    "copyFormatting": "none",
    "copyOnSelect": false,
    "defaultProfile": "{c3f7e812-4b65-4e92-9a14-7b8d5c2e9f01}",
    "keybindings": [
        { "id": "User.copy.644BA8F2", "keys": "ctrl+c" },
        { "id": "User.find", "keys": "ctrl+shift+f" },
        { "id": "User.paste", "keys": "ctrl+v" },
        { "id": "User.splitPane.A6751878", "keys": "alt+shift+d" },
        { "id": "User.commandPalette.D470528E", "keys": "ctrl+shift+p" },
        { "id": "User.toggleAlwaysOnTop", "keys": "ctrl+shift+a" },
        { "id": "User.prevTab", "keys": "alt+h" },
        { "id": "User.nextTab", "keys": "alt+l" },
        { "id": "User.markMode", "keys": "ctrl+shift+space" }
    ],
    "newTabMenu": [
        { "type": "remainingProfiles" }
    ],
    "profiles": {
        "defaults": {
            "font": {
                "face": "Maple Mono NF CN",
                "size": 12
            }
        },
        "list": [
            {
                "colorScheme": "Adventure",
                "commandline": "E:\\workspace\\msys2\\msys2_shell.cmd -defterm -here -no-start -ucrt64 -shell fish",
                "cursorShape": "bar",
                "font": { "face": "Maple Mono NF CN" },
                "guid": "{c3f7e812-4b65-4e92-9a14-7b8d5c2e9f01}",
                "icon": "E:\\workspace\\msys2\\ucrt64.ico",
                "name": "MSYS2 ucrt64",
                "startingDirectory": "%USERPROFILE%"
            },
            {
                "colorScheme": "Adventure",
                "commandline": "E:\\workspace\\msys2\\msys2_shell.cmd -defterm -here -no-start -clang64 -shell fish",
                "cursorShape": "bar",
                "font": { "face": "Maple Mono NF CN" },
                "guid": "{884281f8-930f-49ff-a87d-0eeea345df01}",
                "icon": "E:\\workspace\\msys2\\clang64.ico",
                "name": "MSYS2 clang64",
                "startingDirectory": "%USERPROFILE%"
            },
            {
                "colorScheme": "Adventure",
                "cursorShape": "bar",
                "font": { "face": "Maple Mono NF CN" },
                "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
                "hidden": false,
                "name": "PowerShell",
                "source": "Windows.Terminal.PowershellCore",
                "startingDirectory": "%USERPROFILE%"
            }
        ]
    },
    "schemes": [
        {
            "background": "#040404",
            "black": "#040404",
            "blue": "#417AB3",
            "brightBlack": "#685656",
            "brightBlue": "#97D7EF",
            "brightCyan": "#BDCFE5",
            "brightGreen": "#99B52C",
            "brightPurple": "#AA7900",
            "brightRed": "#D76B42",
            "brightWhite": "#E4D5C7",
            "brightYellow": "#FFB670",
            "cursorColor": "#FEFFFF",
            "cyan": "#BDCFE5",
            "foreground": "#FEFFFF",
            "green": "#5DA602",
            "name": "Adventure",
            "purple": "#E5C499",
            "red": "#D84A33",
            "selectionBackground": "#606060",
            "white": "#DBDED8",
            "yellow": "#EEBB6E"
        }
    ]
}
